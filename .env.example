# Настройки docker compose. Скопируйте в .env рядом с docker-compose.yml.
# Адрес API, по которому к бэкенду обращается БРАУЗЕР. Вшивается во фронтенд
# при сборке: после изменения — docker compose up -d --build frontend.
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000
BACKEND_PORT=8000
