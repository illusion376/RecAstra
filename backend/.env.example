# Скопировать в .env и поправить под свой провайдер.

# --- Приложение ---
DEBUG=false
# На проде указать домен фронта вместо *
CORS_ORIGINS=*

# --- Авторизация ---
# false — ручки открыты без входа (только для отладки)
AUTH_REQUIRED=true
# Секрет подписи токенов. Пусто — сгенерируется в data/.auth_secret.
# На сервере задать явно: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
# Сколько живёт токен, часы
AUTH_TOKEN_TTL_HOURS=168
# Где хранить пользователей
USERS_FILE=data/users.json

# --- LLM ---
# mock          — извлечение по правилам, без сети и ключей (работает сразу)
# yandex_gpt    — YandexGPT, нативный API Yandex Cloud Foundation Models
# openai_compat — любой OpenAI-совместимый /chat/completions
LLM_PROVIDER=mock

# ВАЖНО: SpeechKit — это НЕ языковая модель, а распознавание речи.
# Он стоит на месте Whisper и настройки здесь не требует: его ответ
# отправляется на POST /api/v1/analysis/from-speechkit как есть.
# Языковая модель у Яндекса называется YandexGPT — блок ниже про неё.

# --- YandexGPT ---
# Что нужно получить в консоли Yandex Cloud:
#   1) ID каталога (folder id) — на странице каталога;
#   2) сервисный аккаунт с ролью ai.languageModels.user на этом каталоге;
#   3) API-ключ этого сервисного аккаунта.
# LLM_PROVIDER=yandex_gpt
# YANDEX_FOLDER_ID=b1g...
# YANDEX_API_KEY=AQVN...
# yandexgpt (8k контекст) | yandexgpt-lite (дешевле) | yandexgpt-32k (длинные встречи)
# YANDEX_MODEL=yandexgpt
# YANDEX_MODEL_VERSION=latest
# У Foundation Models жёсткие лимиты RPS — начните с 1-2, поднимайте по факту
# LLM_CONCURRENCY=2
# У yandexgpt контекст 8k токенов, поэтому карту разговора урезаем
# MAP_CONTEXT_CHARS=8000
# Для yandexgpt-32k можно вернуть 12000-20000
# LLM_MAX_TOKENS=2000
# Строгий JSON: если каталог не поддержит, провайдер сам снимет поле
# YANDEX_JSON_MODE=false

# Альтернатива: у Yandex Cloud есть OpenAI-совместимая ручка. Если она
# в вашем каталоге работает, можно обойтись провайдером openai_compat:
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
# LLM_MODEL=gpt://<folder_id>/yandexgpt/latest
# LLM_API_KEY=<API-ключ>
# LLM_SUPPORTS_JSON_MODE=false

# --- ChatGPT через прокси proxyapi.ru (проверено на живых запросах) ---
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.proxyapi.ru/v1
# LLM_MODEL=openai/gpt-5-mini
# LLM_API_KEY=sk-...
#
# gpt-5-mini — рассуждающая модель, у неё три особенности:
#   1) вместо max_tokens требует max_completion_tokens;
#   2) принимает только температуру 1, прочие значения отвергает с 400;
#   3) часть лимита тратит на размышления, поэтому потолок нужен щедрый —
#      при тесном лимите ответ приходит пустым.
# Провайдер подстраивается под первые два пункта сам, но лучше задать явно,
# чтобы не тратить лишний запрос на выяснение:
# LLM_TOKEN_PARAM=max_completion_tokens
# LLM_TEMPERATURE=1
# LLM_MAX_TOKENS=16000
# LLM_TIMEOUT=180
#
# Внимание: gpt-4o-mini на этом тарифе отвечает 403 «Model not allowed».
# Список доступных моделей — GET https://api.proxyapi.ru/v1/models

# Примеры настройки под другие провайдеры — раскомментировать нужный блок.

# OpenAI напрямую
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

# Ollama (локально, ключ не нужен)
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b-instruct
# LLM_API_KEY=
# LLM_CONCURRENCY=1

# LM Studio
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=qwen2.5-14b-instruct
# LLM_API_KEY=lm-studio

# DeepSeek
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-...

LLM_TEMPERATURE=0.1
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=4096
# Выставить false, если провайдер не понимает response_format=json_object
LLM_SUPPORTS_JSON_MODE=true
# Сколько чанков обрабатывать параллельно
LLM_CONCURRENCY=3

# --- Распознавание речи (загрузка аудио в POST /meetings) ---
# none   — загрузка аудио отключена, работаем с готовой расшифровкой
#          через POST /meetings/from-transcript
# nexara — расшифровываем загруженный файл сами
STT_PROVIDER=none
# NEXARA_API_KEY=nx-...
#
# Голосов на записи. На встрече заказчика с техническим специалистом их двое,
# и явное указание заметно снижает число ошибок на границах реплик
# (диаризация без этого режет посреди фразы). 0 — определять автоматически.
NEXARA_NUM_SPEAKERS=2
#
# Nexara умеет размечать реплики сразу ролями вместо обезличенных speaker_0.
# Это снимает отдельный шаг «кто из говорящих заказчик».
# Пусто — оставить обезличенные метки.
NEXARA_ROLES=Заказчик,Менеджер
#
# Распознавание часовой записи идёт минуты
NEXARA_TIMEOUT=600
TRANSCRIPT_LANGUAGE=ru

# Куда складывать загруженные записи и потолок размера (как на фронте)
MEDIA_DIR=media
MAX_UPLOAD_MB=200

# --- Конвейер ---
# Сколько символов транскрипта уходит в проход «карта разговора».
# Ограничено контекстом модели: для yandexgpt ставьте ~8000
MAP_CONTEXT_CHARS=12000
# Порог схлопывания дублей: выше — меньше склеек
DEDUP_THRESHOLD=0.82
# Порог нечёткого совпадения цитаты с транскриптом
QUOTE_MATCH_THRESHOLD=0.62

# Экспортированные ТЗ (сохраняются после перезапуска)
DOCUMENTS_DIR=documents
