{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Бэкенд: uvicorn --reload",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Фронтенд: npm run dev",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Проверка: посмотреть результат глазами",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/check.py",
      "args": ["--show-source"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Тест: основной сценарий",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/smoke_test.py",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Тест: адаптер /meetings (контракт фронта)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/test_meetings.py",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Тест: путь настоящей LLM",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/test_llm_path.py",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Тест: YandexGPT и SpeechKit",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/test_yandex.py",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Тест: разбор ответа Nexara",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/test_nexara.py",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Замер: дедупликация",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/probe_dedup.py",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ],
  "compounds": [
    {
      "name": "Всё вместе: фронт + бэк",
      "configurations": ["Бэкенд: uvicorn --reload", "Фронтенд: npm run dev"]
    }
  ]
}
